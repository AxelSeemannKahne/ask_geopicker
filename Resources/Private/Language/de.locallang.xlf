                <source>Find address on map</source>
                <target>Adresse auf Karte finden</target>
            </trans-unit>
            <trans-unit id="askgeo.success.geocoding" resname="askgeo.success.geocoding">
                <source>Geocoding successful</source>
                <target>Geocoding erfolgreich</target>
            </trans-unit>
            <trans-unit id="askgeo.success.marker_moved" resname="askgeo.success.geocoding">
